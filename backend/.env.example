APP_NAME=GrowthLens API
API_PREFIX=/api
PORT=8001
DEBUG=True
DATABASE_PATH=data/growthlens.db

# Comma-separated, no brackets/quotes needed — works directly in Render's env var UI.
# For production, replace with your actual Vercel URL, e.g.:
# CORS_ORIGINS=https://growthlens.vercel.app,http://localhost:4028
CORS_ORIGINS=http://localhost:4028,http://127.0.0.1:4028
